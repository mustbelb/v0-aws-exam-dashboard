# Copy to .env.local; do not commit real configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key for trusted question issuance; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
DYNAMODB_REGION=us-east-2
DYNAMODB_TABLE_NAME=exam-questions
# Local development can use an authenticated AWS_PROFILE.
# Amplify must use an SSR compute role scoped to the question table.
# AWS_PROFILE=
AUTHENTICATED_GENERATOR_URL=
# Enable only for the local, sample-data design/lesson preview.
DESIGN_PREVIEW=false
